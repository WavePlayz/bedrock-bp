{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"module": "ESNext",

		"rootDir": "src",
		"outDir": "scripts",

		"allowJs": true,
		"checkJs": true,
		"noEmit": false,

		"strict": false,
		"noImplicitAny": false,

		"types": ["@bedrock-apis/env-types"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
